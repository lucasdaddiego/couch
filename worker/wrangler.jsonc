// Couch's Board Worker. No secrets: every setting is a var. Deployed on couch.daddiego.com.ar
// (Lucas's OK, 2026-10-10): the zone has Always Use HTTPS off and one Single Redirect (HTTP to
// HTTPS for every other host), so this host answers plain HTTP for the PS3 (design section 4).
//   wrangler deploy --env-file ~/.config/cloudflare/personal.env
{
  "name": "couch-board",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "couch.daddiego.com.ar", "custom_domain": true }],
  "vars": {
    "CITY": "Buenos Aires",
    "LAT": "-34.6037",
    "LON": "-58.3816",
    "TZ": "America/Argentina/Buenos_Aires",
    "CASAS": "oficial:Oficial,blue:Blue,bolsa:MEP,contadoconliqui:CCL,cripto:Cripto,tarjeta:Tarjeta",
    "LOCALE": "es-AR",
    "USD_TTL": "300",
    "WX_TTL": "900"
  }
}
