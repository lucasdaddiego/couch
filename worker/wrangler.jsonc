// Couch's Board Worker. No secrets: every setting is a var. Deployed on couch.daddiego.com.ar
// (Lucas's OK, 2026-10-10): the zone has Always Use HTTPS off and one Single Redirect (HTTP to
// HTTPS for every other host), so this host answers plain HTTP for the PS3 (design section 4).
// The place is Junin, Buenos Aires: Open-Meteo at the coordinates of SMN's station there (WMO
// 87548), SMN_STATION the station's name in SMN's tiepre file (case and accents not counted).
// CITY keeps the accent (U+00ED): Couch draws it with text_utf8 and folds it to "i" without.
// Since 2026-10-13: the money extras of argentinadatos.com (PF_BANK names the bank of the
// fixed-term rate as its table writes it, case and accents not counted; empty: no such line) and
// the news of NEWS_FEEDS ("Label=URL" or "Label*weight=URL" between commas, at most 6; empty: no
// news), at most NEWS_MAX (8) headlines, the weight a feed's share of them. Of each feed the
// Worker reads only the head: up to the end of its 8th item, at most 96 KB, when those items are
// newest first, else up to its 100th item, at most 256 KB, sorted by date. The mix (Lucas's
// choice, 2026-10-13): 3 economy (Infobae 2, Ambito 1), 3 politics (Infobae 2, Clarin 1), 2 world
// (Clarin 1, BBC 1), the label the publisher. Infobae through Google News' RSS search: Infobae's
// own feed answers HTTP 403 to the Worker (Cloudflare's egress).
//   wrangler deploy --env-file ~/.config/cloudflare/personal.env
{
  "name": "couch-board",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "couch.daddiego.com.ar", "custom_domain": true }],
  "vars": {
    "CITY": "Junín",
    "LAT": "-34.58",
    "LON": "-60.94",
    "TZ": "America/Argentina/Buenos_Aires",
    "SMN_STATION": "Junín",
    "CASAS": "oficial:Oficial,blue:Blue,bolsa:MEP,contadoconliqui:CCL,cripto:Cripto,tarjeta:Tarjeta",
    "LOCALE": "es-AR",
    "USD_TTL": "300",
    "WX_TTL": "900",
    "SMN_TTL": "600",
    "PF_BANK": "Banco de la Nación Argentina",
    "PF_LABEL": "Plazo fijo BNA (TNA)",
    "NEWS_FEEDS": "Ámbito*3=https://www.ambito.com/rss/pages/economia.xml,Clarín*3=https://www.clarin.com/rss/politica/,Clarín=https://www.clarin.com/rss/mundo/,BBC=https://feeds.bbci.co.uk/news/world/rss.xml",
    "NEWS_MAX": "8",
    "RP_TTL": "900",
    "IPC_TTL": "21600",
    "PF_TTL": "3600",
    "NEWS_TTL": "600"
  }
}
